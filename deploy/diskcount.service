[Unit]
Description=DiskCount Telegram HDD/SSD deal notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diskcount
Group=diskcount
WorkingDirectory=/opt/diskcount
EnvironmentFile=/etc/diskcount.env
ExecStart=/opt/diskcount/.venv/bin/python -m diskcount run
Restart=on-failure
RestartSec=10
StateDirectory=diskcount
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/diskcount

[Install]
WantedBy=multi-user.target
